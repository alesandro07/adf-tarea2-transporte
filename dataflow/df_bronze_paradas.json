{
	"name": "df_bronze_paradas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_raw_csv",
						"type": "DatasetReference"
					},
					"name": "csvParadas"
				},
				{
					"dataset": {
						"referenceName": "ds_dw_bronce_paradas",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_raw_excel",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dw_bronce_paradas",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "union2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fec_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_reportados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csvParadas",
				"source(output(",
				"          parada_id as string,",
				"          codigo as string,",
				"          nombre as string,",
				"          latitud as string,",
				"          longitud as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"csvParadas select(mapColumn(",
				"          nroParada = nro_parada,",
				"          nombreParada = nombre_parada,",
				"          zona,",
				"          latitud,",
				"          longitud,",
				"          vigenciaDesde = fecha_desde,",
				"          vigenciaHasta = fecha_hasta,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source2 select(mapColumn(",
				"          nroParada = nro_parada,",
				"          nombreParada = nombre_parada,",
				"          zona,",
				"          latitud,",
				"          longitud,",
				"          vigenciaDesde = fecha_desde,",
				"          vigenciaHasta = fecha_hasta,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1, source1 union(byName: true)~> union1",
				"union1, select2 union(byName: true)~> union2",
				"union2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          parada_id as string,",
				"          codigo as string,",
				"          nombre as string,",
				"          latitud as string,",
				"          longitud as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nroParada,",
				"          nombreParada,",
				"          zona,",
				"          latitud,",
				"          longitud,",
				"          vigenciaDesde,",
				"          vigenciaHasta,",
				"          estado,",
				"          codigo",
				"     )) ~> sink1"
			]
		}
	}
}