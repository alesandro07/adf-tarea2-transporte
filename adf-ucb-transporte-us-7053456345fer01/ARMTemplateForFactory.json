		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_viajes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_raw_csv",
								"type": "DatasetReference"
							},
							"name": "ViajesCSV"
						},
						{
							"dataset": {
								"referenceName": "ds_raw_excel",
								"type": "DatasetReference"
							},
							"name": "ViajesExcel"
						},
						{
							"dataset": {
								"referenceName": "ds_raw_sql",
								"type": "DatasetReference"
							},
							"name": "viajesSQL"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dw_bronce_viajes",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "select1"
						},
						{
							"name": "select2"
						},
						{
							"name": "select3"
						},
						{
							"name": "union1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          id_viaje as string,",
						"          cod_ruta as string,",
						"          nro_bus as string,",
						"          fec_servicio as string,",
						"          hora_programada as string,",
						"          hora_salida as string,",
						"          hora_llegada as string,",
						"          pasajeros_reportados as string,",
						"          km_recorridos as string,",
						"          estado_viaje as string,",
						"          tipo_metrica as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     wildcardPaths:['viajes.csv']) ~> ViajesCSV",
						"source(output(",
						"          id_viaje as string,",
						"          cod_ruta as string,",
						"          nro_bus as string,",
						"          fecha_servicio as string,",
						"          hora_programada as string,",
						"          hora_salida as string,",
						"          hora_llegada as string,",
						"          pasajeros_estimados as string,",
						"          km_recorridos as string,",
						"          estado_viaje as string,",
						"          tipo_metrica as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ViajesExcel",
						"source(output(",
						"          AnioFuente as string,",
						"          ViajeId as string,",
						"          RutaHistoricaId as string,",
						"          VehiculoId as string,",
						"          FechaServicio as string,",
						"          HoraProgramada as string,",
						"          HoraSalida as string,",
						"          HoraLlegada as string,",
						"          ValidacionesTarjeta as string,",
						"          KmRecorridos as string,",
						"          EstadoViaje as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> viajesSQL",
						"ViajesCSV select(mapColumn(",
						"          id_viaje,",
						"          cod_ruta,",
						"          nro_bus,",
						"          fec_servicio,",
						"          hora_programada,",
						"          hora_salida,",
						"          hora_llegada,",
						"          pasajeros_reportados,",
						"          km_recorridos,",
						"          estado_viaje,",
						"          tipo_metrica",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"ViajesExcel select(mapColumn(",
						"          id_viaje,",
						"          cod_ruta,",
						"          nro_bus,",
						"          fec_servicio = fecha_servicio,",
						"          hora_programada,",
						"          hora_salida,",
						"          hora_llegada,",
						"          pasajeros_reportados = pasajeros_estimados,",
						"          km_recorridos,",
						"          estado_viaje,",
						"          tipo_metrica",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"viajesSQL select(mapColumn(",
						"          AnioFuente,",
						"          id_viaje = ViajeId,",
						"          cod_ruta = RutaHistoricaId,",
						"          nro_bus = VehiculoId,",
						"          fec_servicio = FechaServicio,",
						"          hora_programada = HoraProgramada,",
						"          hora_salida = HoraSalida,",
						"          hora_llegada = HoraLlegada,",
						"          pasajeros_reportados = ValidacionesTarjeta,",
						"          km_recorridos = KmRecorridos,",
						"          estado_viaje = EstadoViaje",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select3",
						"select1, select2, select3 union(byName: true)~> union1",
						"union1 derive(AnioFuente = 2022,",
						"          fec_servicio = iifNull(toDate(fec_servicio, 'yyyy-MM-dd'), iifNull(toDate(fec_servicio, 'dd/MM/yyyy'), toDate('2022-01-01'))),",
						"          hora_programada = iifNull(toTimestamp(iif(length(trim(toString(hora_programada))) == 5, concat(trim(toString(hora_programada)), ':00'), trim(toString(hora_programada))), 'HH:mm:ss'), toTimestamp('00:00:00', 'HH:mm:ss')),",
						"          hora_salida = iifNull(toTimestamp(iif(length(trim(toString(hora_salida))) == 5, concat(trim(toString(hora_salida)), ':00'), trim(toString(hora_salida))), 'HH:mm:ss'), toTimestamp('00:00:00', 'HH:mm:ss')),",
						"          hora_llegada = iifNull(toTimestamp(iif(length(trim(toString(hora_llegada))) == 5, concat(trim(toString(hora_llegada)), ':00'), trim(toString(hora_llegada))), 'HH:mm:ss'), toTimestamp('00:00:00', 'HH:mm:ss')),",
						"          cod_ruta = iifNull(toInteger(cod_ruta), 32),",
						"          km_recorridos = iif(isNull(km_recorridos) || length(trim(toString(km_recorridos))) == 0, toFloat(0.0), toFloat(replace(toString(km_recorridos), ',', '.'))),",
						"          nro_bus = iifNull(toString(nro_bus), 'SIN_BUS'),",
						"          estado_viaje = iifNull(toString(estado_viaje), 'DESCONOCIDO')) ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy(AnioFuente,",
						"          id_viaje),",
						"     cod_ruta = iifNull(toInteger(first(cod_ruta)), 32),",
						"          nro_bus = iifNull(toString(first(nro_bus)), 'SIN_BUS'),",
						"          fec_servicio = first(fec_servicio),",
						"          hora_programada = first(hora_programada),",
						"          hora_salida = first(hora_salida),",
						"          hora_llegada = first(hora_llegada),",
						"          pasajeros_reportados = first(pasajeros_reportados),",
						"          km_recorridos = first(km_recorridos),",
						"          estado_viaje = iifNull(toString(first(estado_viaje)), 'DESCONOCIDO')) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as integer,",
						"          id_viaje as string,",
						"          cod_ruta as integer,",
						"          nro_bus as string,",
						"          fec_servicio as date,",
						"          hora_programada as timestamp,",
						"          hora_salida as timestamp,",
						"          hora_llegada as timestamp,",
						"          pasajeros_reportados as integer,",
						"          km_recorridos as double,",
						"          estado_viaje as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          id_viaje,",
						"          cod_ruta,",
						"          nro_bus,",
						"          fec_servicio,",
						"          hora_programada,",
						"          hora_salida,",
						"          hora_llegada,",
						"          pasajeros_reportados,",
						"          km_recorridos,",
						"          estado_viaje",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_raw_csv')]",
				"[concat(variables('factoryId'), '/datasets/ds_raw_excel')]",
				"[concat(variables('factoryId'), '/datasets/ds_raw_sql')]",
				"[concat(variables('factoryId'), '/datasets/ds_dw_bronce_viajes')]"
			]
		}
	]
}